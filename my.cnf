# MySQL 8.4 tuning for a dcm4chee PACS archive DB on a small shared host (~6 GiB RAM,
# all containers co-located). This instance serves only `pacsdb`; Keycloak runs on
# its own MariaDB container.
# For a bigger production host: innodb_buffer_pool_size ~ 50-60% of RAM and
# innodb_flush_log_at_trx_commit = 1.
[mysqld]
# --- durability vs. speed (test machine: may lose up to 1s of transactions on power loss) ---
innodb_flush_log_at_trx_commit = 2

# --- memory ---
innodb_buffer_pool_size = 768M
# innodb_buffer_pool_instances vise nema smisla postavljati: MySQL 8.4 ga drzi na 1
# za pool ispod 1G (stari recept "instances=4" iz PDF-a vazi samo za velike pool-ove).
innodb_redo_log_capacity = 512M
innodb_log_buffer_size = 64M
tmp_table_size = 64M
max_heap_table_size = 64M
sort_buffer_size = 2M
join_buffer_size = 1M

# --- connections and caches ---
max_connections = 200
thread_cache_size = 50
table_open_cache = 2048
open_files_limit = 65535
max_allowed_packet = 64M

# --- I/O ---
innodb_flush_method = O_DIRECT
innodb_io_capacity = 500
innodb_io_capacity_max = 1000
innodb_flush_neighbors = 0
skip-name-resolve
skip-log-bin

# --- RAM savings on small hosts; enable for diagnostics when needed ---
performance_schema = OFF
mysqlx = OFF

# --- logs ---
log_error = /var/lib/mysql/error.log
