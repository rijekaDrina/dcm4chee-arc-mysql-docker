# Primer .env fajla: deploy.py ga generise automatski sa slucajnim lozinkama.
# Kopirati rucno samo ako se deploy zaobilazi; sve vrednosti obavezne.

# Javno DNS ime i IP na koji se vezuju portovi hosta
PUBLIC_HOST=pacs.example.com
PUBLIC_BIND_IP=192.0.2.10

# PACS administrator (realm dcm4che); kreira ga scripts/configure-users.py
PACS_ADMIN_USER=pacsadmin

# Baze
MYSQL_ROOT_PASSWORD=change-me
PACS_DB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# LDAP admin (cn=admin,dc=dcm4che,dc=org)
LDAP_ROOT_PASSWORD=change-me

# Keycloak master administrator
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=change-me

# TLS
TLS_KEYSTORE_PASSWORD=change-me
EXTRA_CACERTS_PASSWORD=changeit
